# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM (required) -------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq model, see https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Retrieval (optional) -------------------------------------------------
# JSON corpus: {"documents": [{"id": 1, "text": "..."}]}
CUAD_JSON_PATH=data/sample_contracts.json
INDEX_DIR=index_cuad.faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_TOP_K=5
MAX_CONTEXT_CHARS=6000

# --- Translation (optional) -----------------------------------------------
TRANSLATION_MODEL=facebook/m2m100_418M
